{
  "name": "web",
  "private": true,
  "scripts": {
    "prebuild": "pnpm run type-check && pnpm run typegen",
    "build": "next build",
    "predev": "pnpm run typegen",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "lint": "eslint .",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "typegen": "pnpm --filter studio run extract-types && pnpm --filter studio exec sanity typegen generate --config-path ../web/sanity-typegen.json"
  },
  "dependencies": {
    "@react-email/components": "^1.0.10",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^7.20.0",
    "@sanity/image-url": "^2.1.0",
    "@sanity/uuid": "^3.0.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "formik": "^2.4.9",
    "get-youtube-id": "^1.0.1",
    "next": "^16.2.1",
    "next-sanity": "^12.2.1",
    "next-share": "^0.27.0",
    "nodemailer": "^8.0.4",
    "nodemailer-smtp-transport": "^2.7.4",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.4",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.6.0",
    "react-youtube": "^10.1.0",
    "sanity": "^5.18.0",
    "sonner": "^2.0.7",
    "swiper": "^12.1.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6",
    "zod-formik-adapter": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/nodemailer-smtp-transport": "^2.7.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/youtube": "^0.1.2",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "6.0.2"
  }
}
